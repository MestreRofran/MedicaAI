rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    // Cada pessoa autenticada acessa exclusivamente seu próprio backup criptografado.
    match /users/{userId}/medicaai/data {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'format', 'v', 'kdf', 'cipher', 'salt', 'iv', 'data', 'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'format', 'v', 'kdf', 'cipher', 'salt', 'iv', 'data', 'updatedAt'
        ])
        && request.resource.data.format == 'MedicaAI-vault'
        && request.resource.data.v == 1
        && request.resource.data.kdf == 'PBKDF2-SHA256-250000'
        && request.resource.data.cipher == 'AES-GCM-256'
        && request.resource.data.salt is string
        && request.resource.data.iv is string
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 800000
        && request.resource.data.updatedAt is string;
      allow delete: if isOwner(userId);
    }
    // Não permitir nenhuma outra leitura ou escrita neste banco.
    match /{document=**} { allow read, write: if false; }
  }
}
